# ==============================================================================
# ПРИМЕР ФАЙЛА ОКРУЖЕНИЯ ДЛЯ РАЗВЕРТЫВАНИЯ ИНФРАСТРУКТУРЫ (.env.example)
# 
# Инструкция:
# 1. Скопируйте данный файл: cp .env.example .env
# 2. Заполните реальными значениями ваших учетных записей Yandex Cloud,
#    SSH-ключей и репозиториев.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Авторизация в Yandex Cloud
# ------------------------------------------------------------------------------
# Идентификатор облака и каталога (yc config list)
TF_VAR_cloud_id="b1gxxxxxxxxxxxxxxxxx"
TF_VAR_folder_id="b1gxxxxxxxxxxxxxxxxx"
TF_VAR_default_zone="ru-central1-d"

# Абсолютный путь к JSON-файлу авторизованного ключа сервисного аккаунта
# Создать: yc iam key create --service-account-name <sa-name> -o key.json
TF_VAR_service_account_key_file="/home/username/.yc-keys/key.json"

# ------------------------------------------------------------------------------
# 2. Настройки SSH для доступа к виртуальным машинам
# ------------------------------------------------------------------------------
# Публичный ключ для создания ВМ через Terraform
TF_VAR_public_key_path="/home/username/.ssh/yandex_vm.pub"

# Параметры подключения Ansible / Kubespray и генератора инвентаря
VM_SSH_USER="ubuntu"
VM_SSH_KEY_PATH="$HOME/.ssh/yandex_vm"

# ------------------------------------------------------------------------------
# 3. Вычислительные ресурсы виртуальных машин Kubernetes
# ------------------------------------------------------------------------------
TF_VAR_vm_cores=2
TF_VAR_vm_memory=4
TF_VAR_vm_disk_size=10

# ------------------------------------------------------------------------------
# 4. Бэкенд Terraform (Yandex Object Storage / S3)
# ------------------------------------------------------------------------------
# Статический ключ доступа сервисного аккаунта для работы с бакетом
# Создать: yc iam access-key create --service-account-name <sa-name>
TF_VAR_storage_access_key="YCAJExxxxxxxxxxxxxxxxxxxxx"
TF_VAR_storage_secret_key="YCPKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Экспорт для провайдера AWS S3 бэкенда Terraform
AWS_ACCESS_KEY_ID=$TF_VAR_storage_access_key
AWS_SECRET_ACCESS_KEY=$TF_VAR_storage_secret_key

# ------------------------------------------------------------------------------
# 5. Сетевая топология (Мультизональные подсети кластера)
# ------------------------------------------------------------------------------
TF_VAR_vpc_subnets='{
  "ru-central1-a" = "192.168.10.0/24",
  "ru-central1-b" = "192.168.11.0/24",
  "ru-central1-d" = "192.168.12.0/24"
}'

# ------------------------------------------------------------------------------
# 6. Параметры интеграции CI/CD и Docker Registry
# ------------------------------------------------------------------------------
# Репозиторий приложения на GitHub (формат: owner/repo)
APP_REPO="Dogafas/dip-app"

# Учетные данные для публикации контейнеров в Docker Hub
DOCKERHUB_USERNAME="datadynamo"
# Токен доступа с правами Read & Write (hub.docker.com/settings/security)
DOCKERHUB_TOKEN="dckr_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"