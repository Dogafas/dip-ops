# ============================================
# Yandex Cloud Authentication & Project IDs
# ============================================
TF_VAR_cloud_id="your_cloud_id_here"
TF_VAR_folder_id="your_folder_id_here"
TF_VAR_default_zone="ru-central1-a"

# Путь к файлу авторизованного ключа сервисного аккаунта (абсолютный путь)
TF_VAR_service_account_key_file=/absolute/path/to/your/key.json

# ============================================
# Object Storage Configuration (S3 Backend)
# ============================================
TF_VAR_storage_access_key="your_storage_access_key_here"
TF_VAR_storage_secret_key="your_storage_secret_key_here"

# ============================================
# SSH Configuration
# ============================================
# Путь к вашему публичному SSH-ключу для доступа к узлам кластера
TF_VAR_public_key_path="/absolute/path/to/.ssh/id_rsa.pub"

# ============================================
# Network Configuration (Мультизональные подсети для Kubernetes)
# ============================================
TF_VAR_vpc_subnets='{
  "ru-central1-a" = "192.168.10.0/24",
  "ru-central1-b" = "192.168.11.0/24",
  "ru-central1-c" = "192.168.12.0/24"
}'

# ============================================
# Compute Resources Configuration
# ============================================
AWS_ACCESS_KEY_ID=$TF_VAR_storage_access_key
AWS_SECRET_ACCESS_KEY=$TF_VAR_storage_secret_key